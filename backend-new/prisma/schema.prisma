datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  passwordHash      String
  phone             String?
  role              String             @default("SalesWorker")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime?          @updatedAt
  sales             Sale[]
  stockTransactions StockTransaction[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  products    Product[]
}

model Product {
  id                Int                @id @default(autoincrement())
  sku               String             @unique
  barcode           String?            @unique
  productName       String
  categoryId        Int
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description       String?
  purchasePrice     Float
  sellingPrice      Float
  gstPercentage     Float
  stockQuantity     Float
  minimumStockLevel Float              @default(5)
  unit              String             @default("Piece")
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime?          @updatedAt
  stockTransactions StockTransaction[]
  saleItems         SaleItem[]
  offers            Offer[]

  @@index([productName])
  @@index([categoryId])
}

model StockTransaction {
  id              Int      @id @default(autoincrement())
  productId       Int
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactionType String
  quantity        Float
  previousStock   Float
  newStock        Float
  reference       String?
  remarks         String?
  createdBy       Int?
  creator         User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Offer {
  id                 Int       @id @default(autoincrement())
  name               String
  description        String?
  productId          Int?
  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  offerType          String    @default("PercentageDiscount")
  discountPercentage Float?
  discountAmount     Float?
  minimumQuantity    Float?
  buyQuantity        Int?
  freeQuantity       Int?
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt

  @@index([productId])
}

model Sale {
  id              Int        @id @default(autoincrement())
  invoiceNumber   String     @unique
  customerId      Int?
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  customerAddress String?
  customerGSTIN   String?
  salesWorkerId   Int
  salesWorker     User       @relation(fields: [salesWorkerId], references: [id], onDelete: Restrict)
  agentName       String?
  agentPhone      String?
  subtotal        Float
  discount        Float
  gstAmount       Float
  cgstAmount      Float
  sgstAmount      Float
  grandTotal      Float
  paymentMethod   String     @default("Cash")
  paymentStatus   String     @default("Pending")
  saleStatus      String     @default("Completed")
  createdAt       DateTime   @default(now())
  saleItems       SaleItem[]
  payments        Payment[]

  @@index([createdAt])
  @@index([salesWorkerId])
}

model SaleItem {
  id            Int      @id @default(autoincrement())
  saleId        Int
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  sku           String?
  isCustom      Boolean  @default(false)
  unit          String?
  quantity      Float
  unitPrice     Float
  discount      Float
  gstPercentage Float
  gstAmount     Float
  totalAmount   Float

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id                Int       @id @default(autoincrement())
  saleId            Int
  sale              Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod     String    @default("Cash")
  amount            Float
  transactionId     String?
  providerReference String?
  status            String    @default("Pending")
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([saleId])
}
